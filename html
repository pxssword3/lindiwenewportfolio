<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Minimalist CV</title>
  <style>
    /* CSS Variables & Light Theme Default */
    :root {
      --bg: #fafafa;
      --surface: #ffffff;
      --text: #171717;
      --text-muted: #737373;
      --border: #e5e5e5;
      --accent: #2563eb;
      --accent-hover: #1d4ed8;
      --radius: 8px;
      --transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* Dark Mode Support */
    @media (prefers-color-scheme: dark) {
      :root {
        --bg: #0a0a0a;
        --surface: #121212;
        --text: #f5f5f5;
        --text-muted: #a3a3a3;
        --border: #262626;
        --accent: #3b82f6;
        --accent-hover: #60a5fa;
      }
    }

    /* Base Styles */
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg);
      color: var(--text);
      line-height: 1.6;
      padding: 2rem 1rem;
      display: flex;
      justify-content: center;
    }

    .container {
      width: 100%;
      max-width: 720px;
      background: var(--surface);
      padding: 2.5rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
    }

    /* Header & Contact Links */
    header {
      margin-bottom: 2rem;
      border-bottom: 1px solid var(--border);
      padding-bottom: 1.5rem;
    }

    h1 {
      font-size: clamp(1.75rem, 4vw, 2.25rem);
      font-weight: 600;
      letter-spacing: -0.02em;
    }

    .title {
      color: var(--text-muted);
      font-size: 1.1rem;
      margin-top: 0.25rem;
    }

    .contact-links {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem 1.25rem;
      margin-top: 1rem;
      list-style: none;
    }

    .contact-links a {
      color: var(--accent);
      text-decoration: none;
      font-size: 0.95rem;
      font-weight: 500;
      transition: var(--transition);
      display: inline-flex;
      align-items: center;
      min-height: 44px; /* Touch friendly */
    }

    .contact-links a:hover,
    .contact-links a:focus-visible {
      color: var(--accent-hover);
      text-decoration: underline;
    }

    /* Sections */
    section {
      margin-bottom: 2rem;
    }

    section:last-child {
      margin-bottom: 0;
    }

    h2 {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    /* Experience & Education Items */
    .item {
      padding: 1rem;
      margin-bottom: 0.75rem;
      border-radius: var(--radius);
      border: 1px solid transparent;
      transition: var(--transition);
    }

    /* Interactive Hover/Focus Effect */
    .item:hover {
      background-color: var(--bg);
      border-color: var(--border);
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: baseline;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .item-title {
      font-weight: 600;
      font-size: 1.05rem;
    }

    .item-date {
      font-size: 0.875rem;
      color: var(--text-muted);
    }

    .item-sub {
      font-size: 0.95rem;
      color: var(--text-muted);
      margin-bottom: 0.5rem;
    }

    .item ul {
      padding-left: 1.2rem;
      font-size: 0.95rem;
    }

    .item li {
      margin-bottom: 0.35rem;
    }

    /* Interactive Skill Chips */
    .skills-grid {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      list-style: none;
    }

    .skill-chip {
      background: var(--bg);
      border: 1px solid var(--border);
      padding: 0.4rem 0.8rem;
      border-radius: 20px;
      font-size: 0.875rem;
      font-weight: 500;
      cursor: default;
      transition: var(--transition);
    }

    .skill-chip:hover {
      border-color: var(--accent);
      color: var(--accent);
      transform: translateY(-2px);
    }

    /* Print Stylesheet */
    @media print {
      body {
        background: #fff;
        color: #000;
        padding: 0;
      }
      .container {
        border: none;
        padding: 0;
        max-width: 100%;
      }
      .item:hover {
        background: none;
        border-color: transparent;
      }
      .skill-chip {
        border: 1px solid #ccc;
      }
      .skill-chip:hover {
        transform: none;
      }
    }
  </style>
</head>
<body>

  <main class="container">
    <!-- Header Section -->
    <header>
      <h1>Alex Morgan</h1>
      <p class="title">Full Stack Developer & Designer</p>
      <ul class="contact-links">
        <li><a href="mailto:alex@example.com">alex@example.com</a></li>
        <li><a href="https://github.com" target="_blank" rel="noopener">GitHub</a></li>
        <li><a href="https://linkedin.com" target="_blank" rel="noopener">LinkedIn</a></li>
        <li><a href="tel:+1234567890">+1 (234) 567-890</a></li>
      </ul>
    </header>

    <!-- Experience Section -->
    <section>
      <h2>Experience</h2>
      
      <article class="item">
        <div class="item-header">
          <span class="item-title">Senior Frontend Engineer</span>
          <span class="item-date">2023 — Present</span>
        </div>
        <p class="item-sub">TechCorp Inc.</p>
        <ul>
          <li>Led the redesign of the core web application, improving load times by 40%.</li>
          <li>Architected accessible, mobile-first design system components used across 5 teams.</li>
        </ul>
      </article>

      <article class="item">
        <div class="item-header">
          <span class="item-title">Web Developer</span>
          <span class="item-date">2021 — 2023</span>
        </div>
        <p class="item-sub">Digital Studio</p>
        <ul>
          <li>Developed interactive, responsive web experiences for client applications.</li>
          <li>Optimized CSS and JavaScript assets to achieve near-perfect Lighthouse scores.</li>
        </ul>
      </article>
    </section>

    <!-- Education Section -->
    <section>
      <h2>Education</h2>
      <article class="item">
        <div class="item-header">
          <span class="item-title">B.S. in Computer Science</span>
          <span class="item-date">2017 — 2021</span>
        </div>
        <p class="item-sub">State University</p>
      </article>
    </section>

    <!-- Skills Section -->
    <section>
      <h2>Skills & Technologies</h2>
      <ul class="skills-grid">
        <li class="skill-chip">JavaScript (ES6+)</li>
        <li class="skill-chip">TypeScript</li>
        <li class="skill-chip">React</li>
        <li class="skill-chip">HTML5 / CSS3</li>
        <li class="skill-chip">Node.js</li>
        <li class="skill-chip">Tailwind CSS</li>
        <li class="skill-chip">Git</li>
        <li class="skill-chip">UI/UX Design</li>
      </ul>
    </section>
  </main>

</body>
</html>
